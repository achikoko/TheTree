<idea-plugin>
    <id>io.github.achikoko.thetree</id>
    <name>The Tree</name>
    <version>0.1.0</version>
    <vendor>Achikoko</vendor>

    <description><![CDATA[
    <b>The Tree</b> reshapes the project view.<br/>
    <ul>
      <li>Compacts source folders (e.g. <code>src/main/java</code>) into a single node.</li>
      <li>Compacts additional non-source folders declared in a per-module-root
          <code>thetree.yaml</code> file.</li>
      <li>Orders folders and files arbitrarily via an <code>/order</code> property.</li>
      <li>Hides nodes marked with <code>/hide</code>.</li>
      <li>Renames nodes, optionally with styled fragments, via <code>/rename</code>.</li>
      <li>Optionally shows a virtual <b>Libraries</b> node per module.</li>
    </ul>
    Works across IntelliJ-platform IDEs (IntelliJ IDEA, PyCharm, PhpStorm, and others)
    because it depends only on the platform, not on any language plugin.
    ]]></description>

    <change-notes><![CDATA[
    <b>0.1.0</b> — Initial release: source + declared-folder compaction,
    YAML-driven weight/hidden ordering, and cross-IDE support.
    ]]></change-notes>

    <!-- Build against 2022.2+ . Depending ONLY on the platform module (and NOT on
         com.intellij.java) is what makes the plugin load in PyCharm, PhpStorm, etc.
         See https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <idea-version since-build="222"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- order: run after the Java plugin's ClassesTreeStructureProvider so that when it rebuilds
             .java PsiFileNodes into class nodes, OUR provider still wraps the (rebuilt) node and the
             weight override survives. `after <id>` is ignored in IDEs where that id is absent
             (PyCharm, etc.). Maven's MavenTreeStructureProvider has no id, so pom files can still be
             rebuilt after us — option B (TheTreeProjectViewPane) is the robust fix for that. -->
        <treeStructureProvider implementation="io.github.achikoko.thetree.TheTreeStructureProvider"
                               order="last, after ClassesTreeStructureProvider"/>
        <projectViewNodeDecorator implementation="io.github.achikoko.thetree.nodes.TheTreeNodeDecorator"/>

        <!-- EXPERIMENTAL (option B): a dedicated project-view pane that owns its sort comparator so
             weight is applied by VirtualFile after the whole provider chain, immune to node
             replacement and independent of sort mode. Adds a "The Tree" tab. Remove this line and
             the io.github.achikoko.thetree.view package to discard. -->
        <projectViewPane implementation="io.github.achikoko.thetree.view.TheTreeProjectViewPane"/>

        <projectService serviceImplementation="io.github.achikoko.thetree.settings.TheTreeConfigState"/>
        <projectService serviceImplementation="io.github.achikoko.thetree.config.TheTreeConfigService"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.achikoko.thetree.config.TheTreeVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="dev.thetree.TheTreeActions.CompactSourceFolders"
                class="io.github.achikoko.thetree.settings.TheTreeActions$CompactSourceFolders"
                text="Compact Source Folders" description="Compact source folders such as src/main/java into a single node">
            <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions"
                          relative-to-action="ProjectView.CompactDirectories" anchor="after"/>
        </action>
        <action id="dev.thetree.TheTreeActions.UseConfigFile"
                class="io.github.achikoko.thetree.settings.TheTreeActions$UseConfigFile"
                text="Use 'thetree.yaml'" description="Apply compaction, weight and hidden rules from thetree.yaml">
            <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions"
                          relative-to-action="dev.thetree.TheTreeActions.CompactSourceFolders" anchor="after"/>
        </action>
        <action id="dev.thetree.TheTreeActions.ShowModuleLibraries"
                class="io.github.achikoko.thetree.settings.TheTreeActions$ShowModuleLibraries"
                text="Show Module Libraries" description="Show a virtual Libraries node for each module">
            <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions"
                          relative-to-action="ProjectView.ShowLibraryContents" anchor="after"/>
        </action>
    </actions>
</idea-plugin>
